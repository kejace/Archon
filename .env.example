# Copy to `.env` and fill in the keys you use. All are optional.
#
# Archon drives Claude Code; supply an Anthropic credential here OR run
# `claude` once inside the container to log in (auth is persisted via the
# archon-claude volume in docker-compose.yml).
ANTHROPIC_API_KEY=

# Codex harness (loop.harness="codex") and the informal agent.
OPENAI_API_KEY=

# Informal-agent proof sketches (alternative to OpenAI).
GEMINI_API_KEY=

# Claude-compatible multi-lane / model-alias providers (.archon/.env also works).
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
